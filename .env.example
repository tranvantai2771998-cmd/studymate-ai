# Server-side Gemini key (NEVER expose as VITE_*)
GEMINI_API_KEY=
PORT=3000

# Production hardening
# Comma-separated allowed browser origins for CORS (leave empty for same-origin only)
CORS_ORIGIN=
# Set true when behind reverse proxy/load balancer so rate limiting sees client IP
TRUST_PROXY=false

# Firebase client config (required for Google Drive sync)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
